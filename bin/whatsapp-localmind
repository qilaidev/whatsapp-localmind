#!/usr/bin/env python3
"""Executable wrapper for `whatsapp-localmind` CLI capability layer."""

import sys
from pathlib import Path

# Resolve symlinks so `whatsapp-localmind` works when symlinked into /usr/local/bin or ~/.local/bin
SCRIPT_PATH = Path(__file__).resolve()
PROJECT_ROOT = SCRIPT_PATH.parent.parent
SRC_DIR = PROJECT_ROOT / "src"

if str(SRC_DIR) not in sys.path:
    sys.path.insert(0, str(SRC_DIR))

from wa_localmind.cli import main

if __name__ == "__main__":
    sys.exit(main())
